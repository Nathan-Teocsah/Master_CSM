//Maillage carré [0,x_max] x [0,y_max]

//Définition des bornes
real xmax = 1.0;
real ymax = 1.0;

//Genration du carre
border Gamma1( t = 0 ,xmax){x = t ; y = 0; label = 1;};
border Gamma2( t = 0 ,ymax){x = xmax ; y = t; label = 2;};
border Gamma3( t = 0 ,xmax){x = t ; y = ymax; label = 3;};
border Gamma4( t = 0 ,ymax){x = 0; y = t; label = 4;};
int n = 15;
//mesh Th = buildmesh(Gamma1(n)+Gamma2(n)+Gamma3(-n)+Gamma4(-n));
mesh Th = square(n,n);
fespace Vh(Th,P1);
Vh u,v;
func f=(5*pi^2/4)*sin(pi*x/2)*cos(pi*y);
func g=(pi/2)*cos(pi*y);
func real u0(real x1, real x2){
    real val;
    if (x2==0 & x1<1) val = sin(pi*x1/2);
    else if (x1==1 & x2<=1) val = cos(pi*x2);
    return val;
}

problem Poisson(u,v)=int2d(Th)(dx(u)*dx(v)+dy(u)*dy(v)) - int2d(Th)(f*v) + int1d(Th,Gamma4)(g*v) 
                     + on(Gamma1,u=u0(x,y)) + on(Gamma2,u=u0(x,y));
Poisson;

plot(u);