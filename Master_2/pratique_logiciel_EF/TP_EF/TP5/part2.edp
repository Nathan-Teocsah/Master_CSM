//Genration du carre
border Gamma1( t = 0 ,2*pi/3){x = 150*cos(t) ; y = 150*sin(t); label = 1;};
border Gamma2( t = -75 ,-90){x = t ; y = -2*sin(2*pi/3)*t; label = 2;};
border Gamma3( t = 2*pi/3, 0){x = 180*cos(t) ; y = 180*sin(t); label = 3;};
border Gamma4( t = 180 ,150){x = t; y = 0; label = 4;};
int n = 8;
mesh Th = buildmesh(Gamma1(n)+Gamma2(n)+Gamma3(n)+Gamma4(n));
plot(Th);