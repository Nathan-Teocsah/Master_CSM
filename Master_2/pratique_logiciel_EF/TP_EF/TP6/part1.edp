load "mesh3"
load "tetgen"
load "medit"
include "mesh_sphere.idp"

real mu0 = 4*pi*1E-7;
real eps0 = 8.854E-12;
real sigma1 = 59E6;
real eps1 = eps0;
real B1=1E-4;
real H1=B1/mu0;
real omega=42.58E6;


real unit=1E-2;
real R=1*unit, Re=4*unit;
real hi = 0.2*unit, he=0.4*unit;

meshS ThSi=Sphere(R,hi,11,1);
meshS ThSe=Sphere(Re,he,12,1);
meshS ThS=ThSi+ThSe;

real volteti = hi^3/6, voltete = he^3/6;
real[int] Pi=[0,0,0], Pe=[0,0,(Re+R)/2];
real[int] domaine=[Pi,1,volteti,Pe,2,voltete];
mesh3 Th = tetg(ThS,switch="paAAYYQ",nbofregions=2,regionlist=domaine);


fespace Vh(Th,[P1,P1,P1]);
Vh<complex> [Hx,Hy,Hz],[Vx,Vy,Vz];

macro Curl(Hx, Hy, Hz) [dy(Hz)-dz(Hy), dz(Hx)-dx(Hz), dx(Hy)-dy(Hx)]

solve rfmag([Hx,Hy,Hz],[Vx,Vy,Vz]) =
    int3d(Th,1)((1/(1i*eps1*omega-sigma1))*Curl(Hx,Hy,Hz)'*Curl(Vx,Vy,Vz))
    + int3d(Th,2)((1/(1i*eps0*omega))*Curl(Hx,Hy,Hz)'*Curl(Vx,Vy,Vz))
    + int3d(Th)(1i*omega*mu0*[Hx,Hy,Hz]'*[Vx,Vy,Vz])
    + on(12,Hx=0,Hy=0,Hz=H1);
