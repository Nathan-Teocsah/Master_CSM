// Données géométriques
real H=2, L=5*H;
int Ny=20; // nb de triangles en y
int Nx=round(Ny*L/H); // en x
// Maillage
mesh Th=square(Nx,Ny,[L*x,H*y]);
// Données de l’écoulement
real Q=1; // débit imposé
real mu=0.1; // viscosité
func u1in=6*Q*(y*(H-y))/H^3; // vitesse horizontale en entrée
// Fespace
fespace Uh(Th, P1b);
Uh u1, u2, v1, v2;// inconnue [u1, u2] et fonction test [v1,v2] pour la vitesse
fespace Ph(Th, P1);
Ph p, q; // inconnue p et fonction test q pour la pression
solve stokes ([u1, u2, p], [v1, v2, q])
= int2d(Th)( mu*( dx(u1)*dx(v1) + dy(u1)*dy(v1) + dx(u2)*dx(v2) + dy(u2)*dy(v2) )
- p*dx(v1) - p*dy(v2) - dx(u1)*q - dy(u2)*q )
+ on(1,3, u1=0, u2=0) + on(2, u2=0) + on(4,u1=u1in ,u2=0);

func pexact = -12*Q*mu*(x-L)/H^3;
Ph perr = p-pexact;
plot(u2,fill=false, value=true);