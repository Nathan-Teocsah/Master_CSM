real a=5, b=10;
int nx=50, ny=50;
mesh Th=square(nx,ny,[a*x,b*y]);

fespace Vh(Th,P2);
Vh u1,u2;

real sigma =0;
int nev = 20;
real[int] evtm(nev);
Vh[int] evectm(nev);

varf av(u1,u2)=int2d(Th)(dx(u1)*dx(u2)+dy(u1)*dy(u2)-sigma*u1*u2)
                + on(1,2,3,4,u1=0);
varf bv([u1],[u2])=int2d(Th)(u1*u2);

matrix A=av(Vh,Vh,solver=Crout,factorize=1);
matrix B=bv(Vh,Vh,solver=CG,eps=1E-20);

int ktm=EigenValue(A,B,sym=true,sigma=sigma,value=evtm,tol=1e-10,maxit=0,ncv=0);

for (int i=0; i<nev;i++){
    cout << "---" << "eigenvalue " << i << " : " << evtm[i] << "---" << endl;
};