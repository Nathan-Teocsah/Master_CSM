\newcommand{\theoremcolorbox}[2]{%
	\def\theoremframecommand##1{%
		\begin{tcolorbox}[
			colframe=#1,
			colback=#2,
			arc=3mm,
			boxrule=0.8pt,
			left=6pt,
			right=6pt,
			top=6pt,
			bottom=6pt
			]
			##1
		\end{tcolorbox}
	}%
}


\theoremcolorbox{blue}{white}
\newshadedtheorem{thm}[Theorem]{Théorème}

\theoremcolorbox{red}{white}
\newshadedtheorem{prop}[Proposition]{Proposition}

\theoremcolorbox{Green}{white}
\newshadedtheorem{defi}[Definition]{Définition}

\theoremcolorbox{purple}{white}
\newshadedtheorem{lm}[Lemma]{Lemme}

\theoremcolorbox{purple}{white}
\newshadedtheorem{cor}[Corollary]{Corollaire}

\theoremcolorbox{lightgray}{white}
