\newshadedtheorem{brouillon}[Brouillon]{Brouillon}

\definecolor{myyellow}{rgb}{0.95,0.9,0.6}
\theoremcolorbox{white}{myyellow}
\newshadedtheorem{sol}[Solution]{Solution}

